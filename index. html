<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ELVIS | AIMATEL PROJECTS - FIELD OS</title>
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
<div class="top"><div><h1>ELVIS | AIMATEL PROJECTS</h1><small>ISP FIELD OPERATIONS • FIBER • NETWORKING</small></div><div class="mono" style="text-align:right;font-size:11px"><span id="clock"></span><br><span style="color:#00e676">● LOCAL DB • AUTO-REVOLVE ON</span></div></div>
<div class="wrap">
<div class="side">
<button class="nav active" onclick="go('dash')" id="n-dash"><span><i class="fa-solid fa-gauge"></i> Dashboard</span><b id="c-all">0</b></button>
<button class="nav" onclick="go('tickets')" id="n-tickets"><span><i class="fa-solid fa-ticket"></i> Tickets</span><b id="c-tick">0</b></button>
<button class="nav" onclick="go('los')" id="n-los"><span><i class="fa-solid fa-triangle-exclamation"></i> LOS/Faults</span><b id="c-los" style="background:#ef4444;color:white">0</b></button>
<button class="nav" onclick="go('install')" id="n-install"><span><i class="fa-solid fa-house-signal"></i> Installs</span><b id="c-inst">0</b></button>
<button class="nav" onclick="go('maint')" id="n-maint"><span><i class="fa-solid fa-wrench"></i> Maintenance</span></button>
<button class="nav" onclick="go('inv')" id="n-inv"><span><i class="fa-solid fa-boxes-stacked"></i> Inventory</span></button>
<button class="nav" onclick="go('photos')" id="n-photos"><span><i class="fa-solid fa-camera"></i> Site Photos</span><b id="c-photo">0</b></button>
<div style="margin-top:14px"><label class="mono" style="font-size:10px"><input type="checkbox" id="autoRevolve" checked> Auto-revolve (8s)</label><button onclick="exportAll()" class="btn" style="background:white;color:#0f4c75;border:1px solid #0f4c75;margin-top:8px;font-size:11px"><i class="fa-solid fa-download"></i> Export Report</button></div>
</div>
<div class="main">
<div id="p-dash"><div class="grid grid4"><div class="card kpi"><label>Today's Jobs</label><b id="k-today">0</b></div><div class="card kpi green"><label>Completed</label><b id="k-done">0</b></div><div class="card kpi red"><label>Pending</label><b id="k-pend">0</b></div><div class="card kpi orange"><label>Installations</label><b id="k-inst">0</b></div></div><div class="grid grid2" style="margin-top:10px"><div class="card"><h3>Revolving: <span id="revolveTitle" style="color:#0f4c75">Tickets</span></h3><div id="revolveBox"></div></div><div class="card"><h3>Daily Summary</h3><div id="summary" class="mono" style="font-size:12px;line-height:2"></div><table class="tbl" style="margin-top:8px"><thead><tr><th>Item</th><th>Used</th><th>Remain</th></tr></thead><tbody id="invDash"></tbody></table></div></div></div>
<div id="p-tickets" class="hidden"><div class="card"><h3>ISP Ticket</h3><div class="grid grid2"><input id="tCust" class="inp" placeholder="Customer: John"><select id="tJob" class="inp"><option>LOS</option><option>No Internet</option><option>Slow</option><option>Installation</option><option>Maintenance</option></select><input id="tLoc" class="inp" placeholder="Location: AP 03"><input id="tCause" class="inp" placeholder="Cause"><input id="tAction" class="inp" placeholder="Action: Replaced 35m cable"><input id="tPower" class="inp" placeholder="ONU power: -21 dBm"><select id="tStatus" class="inp"><option>Completed</option><option>Pending</option></select><input type="file" id="tPhotos" multiple accept="image/*" class="inp"></div><button onclick="addTicket()" class="btn" style="margin-top:10px">Save Ticket</button></div><div class="card"><div id="ticketList"></div></div></div>
<div id="p-los" class="hidden"><div class="card" style="border:2px solid #fecaca"><h3 style="color:#b91c1c">LOS TICKET #<span id="losNo">024</span></h3><div class="grid grid2"><input id="lCust" class="inp" placeholder="Customer"><input id="lLoc" class="inp" placeholder="Location"><input id="lTime" class="inp" type="time" value="14:20"><select id="lIssue" class="inp"><option>🔴 LOS</option><option>🟡 PON Blinking</option></select><input id="lOLT" class="inp" placeholder="OLT: vSOL"><input id="lPON" class="inp" placeholder="PON: 1/4/12"><select id="lONU" class="inp"><option>ONU Online</option><option>ONU Offline</option></select><input id="lPower" class="inp" placeholder="Optical Power: -23.4 dBm"><input id="lCause" class="inp" placeholder="Cause: Fiber cut"><input id="lAction" class="inp" placeholder="Action: Spliced"><select id="lRes" class="inp"><option>🟢 Restored</option><option>🟡 Pending</option><option>🔴 Not Restored</option></select><input type="file" id="lPhotos" multiple accept="image/*" class="inp"></div><button onclick="addLOS()" class="btn r" style="margin-top:10px">COMPLETE TICKET</button></div><div class="card"><div id="losList"></div></div></div>
<div id="p-install" class="hidden"><div class="card"><h3>Installations</h3><div class="grid grid2"><input id="iCust" class="inp" placeholder="Customer"><input id="iLoc" class="inp" placeholder="Location"><input id="iONU" class="inp" placeholder="ONU SN"><input id="iRouter" class="inp" placeholder="Router"><input id="iCable" class="inp" placeholder="Drop cable length"><input id="iSplit" class="inp" placeholder="Splitter"><input id="iPow" class="inp" placeholder="Optical power"><input id="iPPPoE" class="inp" placeholder="PPPoE"><input id="iDate" class="inp" type="date"><input type="file" id="iPhotos" multiple accept="image/*" class="inp"></div><button onclick="addInstall()" class="btn g" style="margin-top:10px">Save Installation</button></div><div class="card"><div id="installList"></div></div></div>
<div id="p-maint" class="hidden"><div class="card"><h3>Maintenance History</h3><div class="grid grid2"><input id="mTask" class="inp" placeholder="Task"><input id="mLoc" class="inp" placeholder="Location"><input id="mDate" class="inp" type="date"><input id="mBy" class="inp" placeholder="Tech: Elvis"><textarea id="mNotes" class="inp" style="grid-column:1/-1" placeholder="What you did..."></textarea></div><button onclick="addMaint()" class="btn" style="margin-top:10px">Add to History</button></div><div class="card"><div id="maintList"></div></div></div>
<div id="p-inv" class="hidden"><div class="card"><h3>Inventory</h3><table class="tbl"><thead><tr><th>Item</th><th>Used</th><th>Remaining</th><th>+1</th></tr></thead><tbody id="invTable"></tbody></table><button onclick="saveInv()" class="btn" style="margin-top:10px">Save</button></div></div>
<div id="p-photos" class="hidden"><div class="card"><h3>📸 Site Photos</h3><input type="file" id="sPhoto" accept="image/*" class="inp"><input id="sCap" class="inp" placeholder="Caption: Installation – Customer A, 28 Aug 2026, AP: Wajir-03, -20.8 dBm" style="margin-top:6px"><button onclick="addPhoto()" class="btn" style="margin-top:6px">Upload</button><div id="photoGrid" class="photos" style="margin-top:12px"></div></div></div>
</div>
</div>
<script src="app.js"></script>
</body>
</html>
